# TRUSTPRINT Environment Configuration Template
# Copy this file to .env and adjust values for your local development setup.

# Hardware Connection
TRUSTPRINT_DEVICE_PORT=COM10 # Or /dev/ttyUSB0 on Linux
TRUSTPRINT_BAUD_RATE=115200

# Logging & Telemetry
TRUSTPRINT_LOG_LEVEL=info # trace, debug, info, warn, error

# Cryptographic Engine Mode
# Options: 'hardware' (queries Dabao on-chip TRNG/PKE via Xous) or 'software' (local host fallback for unit testing)
TRUSTPRINT_SIGN_MODE=software

# Path to local bio-sim repository for Verilator test execution
BIO_SIM_PATH=../bio-sim

# Path to open-source Baochip-1x RTL sources for structural parsing
BAOCHIP_RTL_PATH=../dabao/rtl

# Output directory for signed verification certificates
TRUSTPRINT_EVIDENCE_DIR=./evidence/generated
